    "@deepseek-ai/dsh-session-stats": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.8",
