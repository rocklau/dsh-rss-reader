    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.8",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.5",
    "@types/xml2js": "^0.4.14",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
